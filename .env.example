# ==============================================================================
# DeFi Risk Checker - Environment Configuration
# ==============================================================================

# Port and Host for FastAPI server
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Web3 / Sepolia Testnet Configuration
# ------------------------------------------------------------------------------
# Leave blank to use the built-in High-Fidelity Local Simulated Provider.
# To anchor proofs directly on the live Ethereum Sepolia Testnet:
# 1. Provide an RPC URL from Alchemy, Infura, or public (e.g., https://rpc.sepolia.org)
# 2. Provide a funded testnet private key (with Sepolia ETH for gas)
# 3. Deploy the contract using: python contracts/deploy.py
# 4. Fill in the resulting CONTRACT_ADDRESS below.

SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=
CONTRACT_ADDRESS=
EXPLORER_BASE_URL=https://sepolia.etherscan.io
